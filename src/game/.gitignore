# named <script>_launch.log, so one per unattended tool.
*_launch.log
# State file naming the last afk_start()-launched process. Machine-local by
# definition: it holds a PID.
.afk-launch.json
# Advisory lock around ledger.json's load-modify-save. Transient; a stale one
# is reclaimed after 30s.
.ledger.lock
