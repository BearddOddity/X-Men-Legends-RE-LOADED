# Python
__pycache__/
*.pyc
*.pyo

# Tool output (regenerated per-game)
tools/disasm/output/
tools/func_id/output/
tools/recomp/output/

# Game files (user provides their own)
game_files/
*.xbe
*.iso
*.xiso

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
.DS_Store

# Build
build/
bin/
*.obj
*.exe

# Claude Code local state (worktrees are multi-GB; settings are machine-specific)
.claude/worktrees/
.claude/settings.local.json

# Secondary build trees (build/ is covered above)
build_abi/

# Run output and logs (regenerated every run)
*.log
stderr.txt
stdout.txt
abi_stderr.txt
abi_stdout.txt

# Page-zero census diagnostic build and its output (DIAGNOSTIC ONLY -
# never measure coverage or progress on it; see docs/PAGE_ZERO_CENSUS.md)
build_page0/
src/game/page0_stdout.txt
src/game/page0_stderr.txt

# Redundant seed_list copies taken before a bulk edit; seed_list.json is the
# tracked one and git already holds its history
src/game/seed_list.json.bak-*
src/game/seed_list.json.with-*
